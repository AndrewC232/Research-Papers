{
  "model_type": "XGBoost",
  "task": "Binary Classification (Congestion Prediction)",
  "target": "Will speed < 60 mph in next 15 minutes?",
  "dataset": "PeMS-BAY (SF Bay Area, 325 sensors)",
  "training_sensors": 50,
  "feature_columns": [
    "hour",
    "dow",
    "is_weekend",
    "is_rush_am",
    "is_rush_pm",
    "hour_sin",
    "hour_cos",
    "dow_sin",
    "dow_cos",
    "speed",
    "speed_ratio",
    "lag_1",
    "lag_2",
    "lag_3",
    "lag_6",
    "lag_12",
    "roll_mean_6",
    "roll_mean_12",
    "roll_std_6",
    "roll_std_12",
    "roll_min_12",
    "diff_1",
    "diff_3",
    "diff_6",
    "sensor_idx"
  ],
  "n_features": 25,
  "congestion_threshold_mph": 60.0,
  "prediction_horizon_steps": 3,
  "prediction_horizon_minutes": 15,
  "train_samples": 2084160,
  "test_samples": 521040,
  "metrics": {
    "accuracy": 0.9088,
    "f1_score": 0.851,
    "roc_auc": 0.9703
  },
  "hyperparameters": {
    "n_estimators": 300,
    "max_depth": 7,
    "learning_rate": 0.08,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 5,
    "gamma": 0.1
  },
  "training_time_seconds": 20.6
}